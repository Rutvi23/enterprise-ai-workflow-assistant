# LLM provider: "mock" (offline, deterministic, no API key) or "openai" (any OpenAI-compatible endpoint)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Retrieval: "tfidf" (no external calls) or "embeddings" (uses LLM_BASE_URL /embeddings)
RETRIEVER=tfidf
EMBEDDING_MODEL=text-embedding-3-small
# TF-IDF scores are low-ish (0.05 is fine); for embeddings try ~0.25
MIN_SCORE=0.05

# Optional: require X-API-Key header on all /api routes
API_KEY=

DATA_DIR=data
FETCH_ALLOWLIST=api.github.com,httpbin.org
